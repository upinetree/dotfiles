{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/report-session-commit-trigger.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/mise/shims/ruby\" \"$HOME/.claude/hooks/ruby-format.rb\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/mise/shims/ruby\" \"$HOME/.claude/hooks/md-format.rb\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/report-session-trigger.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"done!\" with title \"Claude Code\" sound name \"Glass\"'"
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/mise/shims/ruby\" \"$HOME/.claude/hooks/voicevox-speak.rb\""
          }
        ]
      }
    ]
  }
}
